DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=meow_ledger

AI_API_KEY=your_deepseek_api_key
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

AI_LIMIT_CONCURRENT=5 # 同时最大模型请求数
AI_LIMIT_MIN_INTERVAL=200 # 两次 API 调用最小间隔
AI_LIMIT_RESERVOIR=30 # 令牌桶初始容量
AI_LIMIT_RESERVOIR_INTERVAL=60000
AI_LIMIT_RESERVOIR_REFRESH=30

CHAT_RATE_WINDOW_MS=60000 # 每分钟限流
CHAT_RATE_MAX=15 # 每分钟限流多少次
CHAT_RATE_DAILY_MAX=200 # 每天限流多少次

PORT=3001
